# ==============================================================================
# Haq Saathi - Environment Configuration Template
# Copy this file to .env and configure your production domain and contact email
# ==============================================================================

# Fully Qualified Domain Name (FQDN) for automated TLS issuance
DOMAIN=haqsaathi.org

# Contact email for Let's Encrypt renewal notices and terms of service
LETSENCRYPT_EMAIL=admin@haqsaathi.org

# Internal backend port
PORT=8000
