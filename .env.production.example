# ==============================================================================
# Haq Saathi - Production Environment Configuration Template
# Copy this file to .env.production before running deployment:
# cp .env.production.example .env.production
# ==============================================================================

# Fully Qualified Domain Name (FQDN) for automated Let's Encrypt TLS issuance
# Example: haqsaathi.org or welfare.karnataka.gov.in
DOMAIN_NAME=haqsaathi.org

# Contact email for Let's Encrypt certificate renewal alerts and TOS
LETSENCRYPT_EMAIL=admin@haqsaathi.org

# Cryptographic secret for signing JWT beneficiary session tokens (min 64 chars)
# Generate with: openssl rand -hex 32
HAQ_SAATHI_JWT_SECRET=d9f4e2a8b3c14789562013fcedab8471928374650192837465abcdef12345678

# Optional: External Indic Voice / STT / TTS API Key (e.g. Sarvam AI, Bhashini)
SARVAM_API_KEY=

# Internal application port for FastAPI backend
PORT=8000
